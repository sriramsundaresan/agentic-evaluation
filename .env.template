# ============================================================
# Azure OpenAI Configuration
# ============================================================
# Your Azure OpenAI endpoint (e.g., https://<resource-name>.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Authentication: Uses Azure Entra ID (DefaultAzureCredential)
# No API key needed. Make sure you are logged in via:
#   az login
# And your account has the "Cognitive Services OpenAI User" role on the resource.

# API version
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ============================================================
# Model Deployments
# ============================================================
# Deployment name for the agent (e.g., gpt-4o, gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Deployment name for the LLM judge (can be the same or a stronger model)
# If not set, defaults to AZURE_OPENAI_DEPLOYMENT_NAME
AZURE_OPENAI_JUDGE_DEPLOYMENT_NAME=gpt-4o

# ============================================================
# Foundry Configuration (for later deployment)
# ============================================================
# FOUNDRY_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api
# FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o
